# Environment configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Shop Management System"

# Security & JWT
JWT_SECRET_KEY=dev-insecure-secret-key-replace-in-production-abcdef1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Streams, Cache, Locks)
REDIS_URL=redis://redis:6379/0
REDIS_LOCAL_URL=redis://localhost:6379/0

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database URLs for Docker services
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
INVENTORY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/inventory_db
BILLING_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/billing_db

# Database URLs for local development (outside Docker)
AUTH_DATABASE_LOCAL_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
INVENTORY_DATABASE_LOCAL_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db
BILLING_DATABASE_LOCAL_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/billing_db

# Service Internal URLs (for Gateway routing)
AUTH_SERVICE_URL=http://auth_service:8001
INVENTORY_SERVICE_URL=http://inventory_service:8002
BILLING_SERVICE_URL=http://billing_service:8003

# Streams & Consumer Groups
ORDERS_STREAM=stream:orders
INVENTORY_STREAM=stream:inventory
DLQ_STREAM=dlq:failed-events

INVENTORY_CONSUMER_GROUP=inventory-group
BILLING_CONSUMER_GROUP=billing-group
